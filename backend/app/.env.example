JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=30
SQL_ECHO=false
DATABASE_URL=mysql+pymysql://enterprise_rag:replace-with-url-safe-password@mysql:3306/enterprise_rag?charset=utf8mb4
MYSQL_DATABASE=enterprise_rag
MYSQL_USER=enterprise_rag
MYSQL_PASSWORD=replace-with-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-url-safe-password
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
AI_RATE_LIMIT=10
AI_RATE_WINDOW_SECONDS=60
DOCUMENT_UPLOAD_RATE_LIMIT=10
DOCUMENT_UPLOAD_RATE_WINDOW_SECONDS=3600
MAX_DOCUMENT_SIZE_MB=10
RAG_MIN_SCORE=0.5
RAG_QUERY_REWRITE_ENABLED=false
ALLOW_SELF_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
