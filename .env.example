# Enterprise RAG environment configuration
# Copy this file to .env. Do not commit the real .env file.

# Application and security
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false
CLIENT_ACCESS_EXPIRE_MINUTES=15
ADMIN_ACCESS_EXPIRE_MINUTES=15
CLIENT_REFRESH_EXPIRE_DAYS=14
ADMIN_REFRESH_EXPIRE_DAYS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SQL_ECHO=false

# MySQL. Passwords used in DATABASE_URL must be URL-safe or percent-encoded.
MYSQL_DATABASE=enterprise_rag
MYSQL_USER=enterprise_rag
MYSQL_PASSWORD=replace-with-a-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-url-safe-password
DATABASE_URL=mysql+pymysql://enterprise_rag:replace-with-a-url-safe-password@mysql:3306/enterprise_rag?charset=utf8mb4

# Infrastructure
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# DeepSeek. Leave empty only when AI answers are intentionally unavailable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Rate limiting and document safety
LOGIN_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60
AI_RATE_LIMIT=10
AI_RATE_WINDOW_SECONDS=60
DOCUMENT_UPLOAD_RATE_LIMIT=10
DOCUMENT_UPLOAD_RATE_WINDOW_SECONDS=3600
MAX_DOCUMENT_SIZE_MB=10

# Retrieval and access policy
RAG_MIN_SCORE=0.5
RAG_QUERY_REWRITE_ENABLED=false
ALLOW_SELF_REGISTRATION=false
ALLOW_REGISTRATION_REQUESTS=true

# Outbound email for approved password-reset requests. Use STARTTLS for port
# 587, or SSL for port 465. Keep disabled until an SMTP account and the public
# HTTPS address are configured.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=notifications@example.com
MAIL_SMTP_PASSWORD=replace-with-the-smtp-password
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
MAIL_FROM=notifications@example.com
PUBLIC_APP_URL=https://rag.example.com
MAIL_TIMEOUT_SECONDS=10
